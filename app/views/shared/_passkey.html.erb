<%= login_with_passkey_form_for(
  resource_name,
  class: "w-full",
  data: { controller: "webauthn-support", action: "webauthn:unsupported->webauthn-support#hide" }
) do |form| %>
  <%= form.button(type: "submit", class: "w-full flex items-center justify-center p-2 rounded-lg border border-neutral-300 cursor-pointer bg-white space-x-1") do %>
    <%= image_tag "passkey-icon.png", class: "w-6" %>
    <span class="text-neutral-700 font-semibold">Ingresar con Passkey</span>
  <% end %>
<% end %>
